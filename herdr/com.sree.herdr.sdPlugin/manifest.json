{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.sree.herdr",
  "Name": "herdr Live",
  "Version": "1.0.0.0",
  "Author": "Sree",
  "Description": "Live, self-syncing tiles for herdr tabs and agents. Tap to jump, long-press to peek.",
  "Category": "herdr Live",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Nodejs": {
    "Version": "24",
    "Debug": "disabled"
  },
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Actions": [
    {
      "UUID": "com.sree.herdr.slot",
      "Name": "Agent Slot",
      "Tooltip": "Shows the herdr tab in this slot. Tap to jump, long-press to see its task.",
      "Icon": "imgs/slot",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/slot",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.sree.herdr.needs",
      "Name": "Needs Me",
      "Tooltip": "Counts agents that are done or blocked. Each press jumps to the next one.",
      "Icon": "imgs/needs",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/needs",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.sree.herdr.more",
      "Name": "More Tabs",
      "Tooltip": "Shows the next set of tabs when there are more tabs than slots.",
      "Icon": "imgs/more",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/more",
          "ShowTitle": false
        }
      ]
    }
  ]
}